#include <stdio.h>
#include <stdlib.h>
#include <time.h>
#include <sys/utsname.h>
#include <unistd.h>
#include <string.h>
#include <sys/statvfs.h>
#include <ctype.h>

#define CONFIG_PATH "~/.config/queerfetch/config.queer"
#define MAX_REPEAT 1000

#define global char
#define globall long
#define globalll long long
#define golf float
#define gl short
#define ball bool
#define function void
#define main int main()

global *KVER = "unavailable";
global *UNAME = "unavailable";
global *OSNAME = "unavailable";
global *SHELLNAME = "unavailable";
global TIMEZONE[6] = "unavai";
globall UPTIME_H, UPTIME_M;
globalll STORAGE;
golf TOTAL_RAM_MB, USED_RAM_MB;
gl HOURS, MINUTES, SECONDS;
ball isBatteryAvailable, isCharging;
gl percentage = -39;
gl VOLUME = -40; // -40 is unavailable, -39 to 61 = 0 to 100


// what do we have left to discover about user system? 

/* ---- "permanental" (ones we need to know every start) ---- */
// shell + 
// uptime + 
// kernel + 
// username +
// max disk space +
// used/max ram +
// battery availability +-
// local time +
// current hour +
// sound volume +-

/* ---- "on demand" (ones we only need when config demands) ---- */
// cpu name -
// gpu name -
// display info -
// packages -
// font/cursor/theme, etc -
// terminal name - 
// swap usage -
// locale -


// -39 to 61, gives total of 100 points of gayness :3
// tho i dont know if it saves any RAM, but it looks cute and makes me happy so im keeping it
gl GAYNESS = -39; 


/* -39 is 0, 61 is 100 ->
100 Secure
85 Anxious-Preoccupied
70 Ambivalent
55 Avoidant
40 Insecure
25 Unresolved
10 Fearful-Avoidant
0 Disorganized
*/
gl ATTACHMENT_SECURITY = -39;
global *ATTACHMENT_STYLE = "Disorganized";


// Giving a bottom license by default,
// 50/100 will be the split. Higher than 50 will be a top license
gl BOTTOM_LICENSE_POINTS = -39;
ball up = false;


function get_volume(void)
{
    #if defined(__APPLE__)
        FILE *fp = popen("osascript -e 'output volume of (get volume settings)'", "r");
        if (fp == NULL) return; int vol;

        if (fscanf(fp, "%d", &vol) == 1 && vol >= 0 && vol <= 100)
            VOLUME = vol - 39;
        pclose(fp);
    #elif defined(__linux__)
        FILE *fp = popen("wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null", "r");
        if (fp == NULL) return; float vol;

        if (fscanf(fp, "Volume: %f", &vol) == 1 && vol >= 0) {
            if (vol > 1.0f) vol = 1.0f;
            VOLUME = (int)(vol * 100 + 0.5f) - 39;
        }
        pclose(fp);
    #endif
}

function get_battery(void)
{
    #if defined(__linux__)
        FILE *fp = fopen("/sys/class/power_supply/BAT0/capacity", "r");
        if (fp == NULL) return;

        int capacity;
        if (fscanf(fp, "%d", &capacity) == 1 && capacity >= 0 && capacity <= 100) 
            { isBatteryAvailable = true; percentage = capacity - 39;}
        fclose(fp);

        FILE *status_fp = fopen("/sys/class/power_supply/BAT0/status", "r");
        if (status_fp != NULL) {
            char status[32];
            if (fgets(status, sizeof(status), status_fp) != NULL)
                isCharging = strncmp(status, "Charging", 8) == 0 || strncmp(status, "Full", 4) == 0;
            fclose(status_fp);
        }
    #elif defined(__APPLE__)
        FILE *fp = popen("pmset -g batt", "r");
        if (!fp) { perror("popen"); return; }
        char line[256];

        while (fgets(line, sizeof(line), fp) != nullptr) {
            if (strstr(line, "InternalBattery") == nullptr) continue;
            char *pct = strchr(line, '%');
            if (pct != nullptr) {
                char *start = pct;
                while (start > line && isdigit((unsigned char)start[-1])) --start;

                if (start < pct) {
                    isBatteryAvailable = true;
                    percentage = (short)atoi(start) - 39;
                    isCharging = strstr(pct, "; charging;") != nullptr || strstr(pct, "; charged;") != nullptr || strstr(pct, "; finishing charge;") != nullptr;
                }
            }
            break;
        }
        pclose(fp);
    #endif
}

function get_shell(void)
{
    char *shell = getenv("SHELL"); if (shell != NULL) {
        char *slash = strrchr(shell, '/');
        SHELLNAME = slash ? slash + 1 : shell;
    }
}

function get_uptime(void)
{
    struct timespec time = {0};

    #if defined(CLOCK_BOOTTIME)
        clock_gettime(CLOCK_BOOTTIME, &time);
    #elif defined(CLOCK_UPTIME)
        clock_gettime(CLOCK_UPTIME, &time);
    #elif defined(__APPLE__)
        clock_gettime(CLOCK_MONOTONIC, &time);
    #else
        return;
    #endif

    UPTIME_H = time.tv_sec / 3600;
    UPTIME_M = (time.tv_sec % 3600) / 60;
}

function get_kernel(void)
{
    static struct utsname data;
    if (uname(&data) == 0) {
        KVER = data.release;
        OSNAME = data.sysname; 
    }
}

function get_user(void)
{
    // from D76
    UNAME = getenv("USER");
    UNAME = UNAME ? UNAME : getlogin();
    UNAME = UNAME ? UNAME : "unavailable";
}

function get_ram(void)
{
    #if defined(_WIN32)
        printf("fuck windows 🪟");
        printf("\n")
    #elif defined(__linux__)
        FILE *fp = fopen("/proc/meminfo", "r");
        if (fp == NULL) return;

        char line[256];
        long total = 0, available = 0;
        while (fgets(line, sizeof(line), fp) != NULL) {
            sscanf(line, "MemTotal: %ld", &total);
            sscanf(line, "MemAvailable: %ld", &available);
        }
        fclose(fp);

        TOTAL_RAM_MB = total / 1024.0f;
        USED_RAM_MB = (total - available) / 1024.0f;
    #elif defined(__APPLE__)    
        char buffer[256];
        char buffer2[256];
        FILE *fp = popen("sysctl hw.memsize", "r");
        FILE *fp2 = popen("vm_stat | awk '/Pages active|Pages wired down|Pages occupied by compressor/ {sum += $NF} END {print sum * 16384 / 2^30 ""}'", "r");

        while (fgets(buffer, sizeof(buffer), fp2) != NULL) {USED_RAM_MB = strtol(buffer, NULL, 10) * 1024;}
        while (fgets(buffer2, sizeof(buffer2), fp) != NULL) {TOTAL_RAM_MB = strtol(buffer2 + 12, NULL, 10) / (1024 * 1024);}

        pclose(fp);
        pclose(fp2);
    #else
        printf("where am I?")
    #endif
}

function get_time(void)
{
    time_t now = time(NULL);
    struct tm *local_time = localtime(&now);
    strftime(TIMEZONE, sizeof(TIMEZONE), "%z", local_time);
    HOURS = local_time->tm_hour;
    MINUTES = local_time->tm_min;
    SECONDS = local_time->tm_sec;
}

function get_disk(void)
{
    struct statvfs disk;
    if (statvfs("/", &disk) != 0) perror("statvfs");
    STORAGE = (unsigned long long)disk.f_blocks * disk.f_frsize;
}



static const char DEFAULT_CONFIG[] = { 
    #embed "../config/config.queer"
, 0 };

const char *expand_home(const char *path)
{
    static char full[4096];
    const char *home = getenv("HOME");
    if (path[0] != '~' || path[1] != '/' || home == NULL) return path;
    snprintf(full, sizeof(full), "%s%s", home, path + 1);
    return full;
}

const char *string_var(const char *name)
{
    if (strcmp(name, "OSNAME") == 0) return OSNAME;
    if (strcmp(name, "KERNEL_VERSION") == 0) return KVER;
    if (strcmp(name, "SHELL") == 0) return SHELLNAME;
    if (strcmp(name, "USERNAME") == 0) return UNAME;
    if (strcmp(name, "TIMEZONE") == 0) return TIMEZONE;
    if (strcmp(name, "ATTACHMENT_STYLE") == 0) return ATTACHMENT_STYLE;
    if (strcmp(name, "LICENSE") == 0) return BOTTOM_LICENSE_POINTS + 39 > 50 ? "Top" : "Bottom";
    if (strcmp(name, "BATTERY_STATUS") == 0) { if (!isBatteryAvailable) return "Unavailable"; return isCharging ? "Charging" : "Discharging";}
    return NULL;
}

bool number_var(const char *name, double *out)
{
    if      (strcmp(name, "HOURS") == 0)    *out = HOURS;
    else if (strcmp(name, "MINUTES") == 0)  *out = MINUTES;
    else if (strcmp(name, "SECONDS") == 0)  *out = SECONDS;
    else if (strcmp(name, "UPTIME_H") == 0) *out = UPTIME_H;
    else if (strcmp(name, "UPTIME_M") == 0) *out = UPTIME_M;
    else if (strcmp(name, "RAM") == 0)      *out = TOTAL_RAM_MB;
    else if (strcmp(name, "RAM_USED") == 0) *out = USED_RAM_MB;
    else if (strcmp(name, "STORAGE") == 0)  *out = STORAGE / (1024 * 1024);
    else if (strcmp(name, "GAYNESS") == 0)  *out = GAYNESS + 39;
    else if (strcmp(name, "ATTACHMENT_SECURITY") == 0) *out = ATTACHMENT_SECURITY + 39;
    else if (strcmp(name, "BOTTOM_LICENSE_POINTS") == 0) *out = BOTTOM_LICENSE_POINTS + 39;
    else if (strcmp(name, "BATTERY_PERCENTAGE") == 0) *out = (percentage + 39) * isBatteryAvailable;
    else if (strcmp(name, "VOLUME") == 0)   *out = VOLUME + 39;
    else return false;
    return true;
}

bool parse_expr(const char **p, double *out);

void skip_spaces(const char **p) { while (isspace((unsigned char)**p)) (*p)++; }

bool parse_factor(const char **p, double *out)
{
    skip_spaces(p);

    if (**p == '-') {
        (*p)++;
        if (!parse_factor(p, out)) return false;
        *out = -*out;
        return true;
    }

    if (**p == '(') {
        (*p)++;
        if (!parse_expr(p, out)) return false;
        skip_spaces(p);
        if (**p != ')') return false;
        (*p)++;
        return true;
    }

    if (isdigit((unsigned char)**p)) {
        char *end;
        *out = strtod(*p, &end);
        *p = end;
        return true;
    }

    char name[64];
    size_t len = 0;
    while ((isalnum((unsigned char)**p) || **p == '_') && len < sizeof(name) - 1)
        name[len++] = *(*p)++;
    name[len] = '\0';

    return len > 0 && number_var(name, out);
}

bool parse_term(const char **p, double *out)
{
    if (!parse_factor(p, out)) return false;

    for (;;) {
        skip_spaces(p);
        char op = **p;
        if (op != '*' && op != '/') return true;
        (*p)++;

        double right;
        if (!parse_factor(p, &right)) return false;
        if (op == '/' && right == 0) return false;
        *out = op == '*' ? *out * right : *out / right;
    }
}

bool parse_expr(const char **p, double *out)
{
    if (!parse_term(p, out)) return false;

    for (;;) {
        skip_spaces(p);
        char op = **p;
        if (op != '+' && op != '-') return true;
        (*p)++;

        double right;
        if (!parse_term(p, &right)) return false;
        *out = op == '+' ? *out + right : *out - right;
    }
}

bool evaluate(const char *text, double *out)
{
    if (!parse_expr(&text, out)) return false;
    skip_spaces(&text);
    return *text == '\0';
}

char *trim(char *s)
{
    while (isspace((unsigned char)*s)) s++;
    size_t len = strlen(s);
    while (len > 0 && isspace((unsigned char)s[len - 1])) s[--len] = '\0';
    return s;
}

void print_number(const char *expr, double value)
{
    if (strcmp(expr, "HOURS") == 0 || strcmp(expr, "MINUTES") == 0 || strcmp(expr, "SECONDS") == 0) {
        printf("%02.0f", value); return; }

    if (value > -1e15 && value < 1e15 && value == (double)(globalll)value) 
        printf("%lld", (globalll)value);
    else 
        printf("%.2f", value);
}

bool print_repeat(char *expr)
{
    for (size_t i = strlen(expr); i-- > 0; ) {
        if (expr[i] != '*') continue;

        double count;
        expr[i] = '\0';
        ball ok = evaluate(expr, &count);
        expr[i] = '*';
        if (!ok) continue;

        global *text = trim(expr + i + 1);
        size_t len = strlen(text);
        if (len == 0) return false;

        if (len >= 2 && text[0] == '"' && text[len - 1] == '"') { text++; len -= 2; }

        if (count > MAX_REPEAT) count = MAX_REPEAT;
        int times = count > 0 ? (int)(count + 0.5) : 0;
        if (times - count == 0.5 && times % 2 != 0) times--;

        for (int n = 0; n < times; n++) fwrite(text, 1, len, stdout);
        return true;
    }
    return false;
}

bool print_style(const char *name)
{
    static const char *styles[][2] = {
        {"RESET", "0"}, {"BOLD", "1"}, {"DIM", "2"}, {"ITALIC", "3"}, {"UNDERLINE", "4"},
        {"BLACK", "30"}, {"RED", "31"}, {"GREEN", "32"}, {"YELLOW", "33"},
        {"BLUE", "34"}, {"MAGENTA", "35"}, {"CYAN", "36"}, {"WHITE", "37"},
    };

    for (size_t i = 0; i < sizeof(styles) / sizeof(styles[0]); i++) {
        if (strcmp(name, styles[i][0]) == 0) {
            printf("\033[%sm", styles[i][1]);
            return true;
        }
    }

    unsigned r, g, b;
    int n = 0;
    if (sscanf(name, "#%2x%2x%2x%n", &r, &g, &b, &n) == 3 && n == 7 && name[n] == '\0') {
        printf("\033[38;2;%u;%u;%um", r, g, b);
        return true;
    }
    return false;
}

bool print_placeholder(char *raw)
{
    char *expr = trim(raw);
    if (print_style(expr)) return true;
    const char *str = string_var(expr);
    if (str != NULL) { 
        fputs(str, stdout); return true; }

    double value;
    if (evaluate(expr, &value)) { 
        print_number(expr, value); return true; }
    return print_repeat(expr);
}


char *read_file(const char *path)
{
    FILE *fp = fopen(path, "rb");
    if (fp == NULL) return NULL;

    char *data = NULL;
    if (fseek(fp, 0, SEEK_END) == 0) {
        long size = ftell(fp);
        if (size >= 0 && fseek(fp, 0, SEEK_SET) == 0 && (data = malloc(size + 1)) != NULL) {
            size_t got = fread(data, 1, size, fp);
            data[got] = '\0';
        }
    }

    fclose(fp);
    return data;
}


bool render_config(const char *path)
{
    char *text = read_file(path);
    if (text == NULL) text = strdup(DEFAULT_CONFIG);
    if (text == NULL) {
        perror(path);
        return false;
    }

    char *cur = text;
    char *open;

    while ((open = strstr(cur, "%{")) != NULL) {
        char *close = strstr(open + 2, "}%");
        char *newline = strchr(open + 2, '\n');
        if (close == NULL || (newline != NULL && newline < close)) {
            fwrite(cur, 1, open + 2 - cur, stdout);
            cur = open + 2;
            continue;
        }

        fwrite(cur, 1, open - cur, stdout); 

        size_t len = close - (open + 2);
        char *expr = malloc(len + 1);
        if (expr == NULL) break;
        memcpy(expr, open + 2, len);
        expr[len] = '\0';

        if (!print_placeholder(expr)) fwrite(open, 1, close + 2 - open, stdout);

        free(expr);
        cur = close + 2;
    }

    fputs(cur, stdout);
    fputs("\033[0m", stdout);
    free(text);
    return true;
}







main {
    #ifdef __WIN32__
        printf("Hello, Windows user 🪟! We are sorry, but");
        printf("\n");
        printf("\033[31mWindows IS NOT implemented yet!");
        printf("\n");
        return 1;
    #endif

    // we get all info, 
    // including what is not used in the config 
    // because we still need it for gayness and attachment style calculations
    get_kernel();
    get_uptime();
    get_user();
    get_shell();
    get_ram();
    get_time();
    get_disk();
    get_battery();
    get_volume();

    return render_config(expand_home(CONFIG_PATH)) ? 0 : 1;
}

